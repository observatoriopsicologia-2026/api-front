{
  "name": "@observatorio-pot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "npm run coverage && npm run build",
    "prebuild": "node scripts/configure-production.mjs",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "typecheck": "ngc -p tsconfig.app.json",
    "lint": "ng build --configuration production",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --experimental-specifier-resolution=node --test \".test-dist/tests/**/*.test.js\"",
    "coverage": "npm run test:build && c8 --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 --include \".test-dist/src/app/**/*.js\" --exclude \".test-dist/src/app/app.routes.js\" --exclude \".test-dist/src/app/core/models.js\" --exclude \".test-dist/tests/**/*.js\" node --experimental-specifier-resolution=node --test \".test-dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@angular/router": "^20.2.0",
    "chart.js": "^4.6.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "c8": "^11.0.0",
    "typescript": "~5.8.2"
  }
}
